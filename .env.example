# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mumbaicha_raja"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRE="7d"

# Admin Credentials (for initial seed)
INITIAL_ADMIN_EMAIL="admin@mumbaicharaja.com"
INITIAL_ADMIN_PASSWORD="ChangeMe123!"

# CORS
FRONTEND_URL="http://localhost:5173"

# Render Production (update when deploying)
# DATABASE_URL="postgresql://..."
# FRONTEND_URL="https://mumbaicharaja.com"
# NODE_ENV="production"

# ─────────────────────────────────────────────────────────────────
# CCAvenue — Environment Mode
# Options: simulator | uat | production
# ─────────────────────────────────────────────────────────────────
CCAVENUE_ENV="simulator"

# ─────────────────────────────────────────────────────────────────
# CCAvenue — Simulator / Default Credentials
# ─────────────────────────────────────────────────────────────────
CCAVENUE_MERCHANT_ID="your_merchant_id"
CCAVENUE_ACCESS_CODE="your_access_code"
CCAVENUE_WORKING_KEY="your_working_key"

# ─────────────────────────────────────────────────────────────────
# CCAvenue — Callback URL (update to your server domain in production)
# ─────────────────────────────────────────────────────────────────
CCAVENUE_REDIRECT_URL="https://mumbaicharaja.co/api/orders/ccavenue-response"

# ─────────────────────────────────────────────────────────────────
# CCAvenue — UAT Credentials (get from service@ccavenue.com)
# ─────────────────────────────────────────────────────────────────
CCAVENUE_UAT_MERCHANT_ID=""
CCAVENUE_UAT_ACCESS_CODE=""
CCAVENUE_UAT_WORKING_KEY=""

# ─────────────────────────────────────────────────────────────────
# CCAvenue — Production Credentials (from M.A.R.S dashboard)
# ─────────────────────────────────────────────────────────────────
CCAVENUE_PROD_MERCHANT_ID=""
CCAVENUE_PROD_ACCESS_CODE=""
CCAVENUE_PROD_WORKING_KEY=""
