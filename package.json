{
  "name": "mumbaicha-raja-backend",
  "version": "1.0.0",
  "description": "Backend API for Mumbai Cha Raja cultural organization",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node src/scripts/migrate.js",
    "migrate:alter": "node src/scripts/migrate.js --alter",
    "migrate:force": "node src/scripts/migrate.js --force",
    "seed": "node src/scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.22.5",
    "pdfkit": "^0.19.1",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": "18.x"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
